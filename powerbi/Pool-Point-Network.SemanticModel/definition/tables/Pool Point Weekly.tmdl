	column 'Stores with Backlog'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 310f3050-f861-4955-bbe9-7888713f5ddd
		sourceColumn: Stores with Backlog

	column 'Open Stores'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: e88ce0e3-75d4-4093-b757-e85d0d0f41e6
		sourceColumn: Open Stores

	column Stops
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: d6f4445b-eba0-416b-ad0b-d86ea55eeb7e
