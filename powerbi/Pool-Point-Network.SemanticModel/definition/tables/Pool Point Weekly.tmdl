table 'Pool Point Weekly'
	lineageTag: a382bb9e-e7a8-4d6c-98b0-b4f898c1eb86

	column 'Pool Point ID'
		dataType: string
		isHidden
		lineageTag: a7ebd19d-8b43-458b-984c-702b2fdc1e46
		summarizeBy: none
		sourceColumn: Pool Point ID

	column 'Week Ending'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 9447e120-7d0d-4e6f-b973-71adca0adbce
		summarizeBy: none
		sourceColumn: Week Ending

	column 'Demand Pallets'
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: b4030878-8be2-4e9a-b8fe-daf2867f4772
