	column 'Total Cost'
		dataType: decimal
		isHidden
		formatString: \$#,0
		lineageTag: 60a9f455-5838-4d04-81e9-c170fea97616
		sourceColumn: Total Cost

	partition 'Pool Point Weekly' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "data\pool_point_weekly_history.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"pool_point_id", "week_ending", "demand_pallets", "pallets_shipped", "backlog_pallets", "stores_with_backlog", "open_stores", "stops", "trailers", "on_time_stops", "linehaul_cost", "handling_cost", "final_mile_cost", "total_cost"}),
				    Renamed = Table.RenameColumns(Selected, {{"pool_point_id", "Pool Point ID"}, {"week_ending", "Week Ending"}, {"demand_pallets", "Demand Pallets"}, {"pallets_shipped", "Pallets Shipped"}, {"backlog_pallets", "Backlog Pallets"}, {"stores_with_backlog", "Stores with Backlog"}, {"open_stores", "Open Stores"}, {"stops", "Stops"}, {"trailers", "Trailers"}, {"on_time_stops", "On-Time Stops"}, {"linehaul_cost", "Linehaul Cost"}, {"handling_cost", "Handling Cost"}, {"final_mile_cost", "Final-Mile Cost"}, {"total_cost", "Total Cost"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Pool Point ID", type text}, {"Week Ending", type date}, {"Demand Pallets", type number}, {"Pallets Shipped", type number}, {"Backlog Pallets", type number}, {"Stores with Backlog", Int64.Type}, {"Open Stores", Int64.Type}, {"Stops", Int64.Type}, {"Trailers", Int64.Type}, {"On-Time Stops", Int64.Type}, {"Linehaul Cost", Currency.Type}, {"Handling Cost", Currency.Type}, {"Final-Mile Cost", Currency.Type}, {"Total Cost", Currency.Type}}, "en-US")
				in
				    Typed

